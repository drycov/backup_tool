# Скопируйте в config и заполните перед развёртыванием:
#   cp oxidized/config.example oxidized/config
#
# Пароли групп синхронизируются из scanner (UI → Настройки / import network_inventory).

username: admin
password: changeme
model: routeros
resolve_dns: true
interval: 3600
use_syslog: false
debug: false
threads: 30
timeout: 20
retries: 3
log: /var/lib/oxidized/oxidized.log
input:
  default: ssh
  ssh:
    secure: false
    port: 44333
source:
  default: http
  debug: false
  http:
    url: http://scanner:8000/api/oxidized/source
    map:
      name: hostname
      model: os
      group: group
      ip: ip
    vars_map:
      ssh_port: ssh_port
    headers:
      Accept: application/json
groups:
  hex:
    username: CHANGE_ME
    password: CHANGE_ME
    model: routeros
  us:
    username: CHANGE_ME
    password: CHANGE_ME
    model: routeros
output:
  default: git
  git:
    user: Oxidized
    email: oxidized@example.com
    repo: /var/lib/oxidized
    single_repo: true
    single_branch: true
    single_branch_name: main
rest: 0.0.0.0:8888
hooks:
  push_to_git:
    type: githubrepo
    events:
      - post_store
    remote_repo: http://gitea.example.com/Oxidized/backups.git
    username: oauth2
    password: ''
