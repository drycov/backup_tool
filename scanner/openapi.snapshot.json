{
  "openapi": "3.1.0",
  "info": {
    "title": "Backup Tools API",
    "version": "3.0.0",
    "description": "REST API для инвентаря, сканирования, Oxidized, compliance и настроек."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key (bk_…) для автоматизации"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        }
      },
      "Device": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ip": {
            "title": "Ip",
            "type": "string"
          },
          "model": {
            "default": "routeros",
            "title": "Model",
            "type": "string"
          },
          "group": {
            "default": "default",
            "title": "Group",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "ports": {
            "items": {
              "type": "integer"
            },
            "title": "Ports",
            "type": "array"
          },
          "site": {
            "default": "",
            "title": "Site",
            "type": "string"
          },
          "role": {
            "default": "",
            "title": "Role",
            "type": "string"
          },
          "critical": {
            "default": false,
            "title": "Critical",
            "type": "boolean"
          },
          "maintenance": {
            "default": false,
            "title": "Maintenance",
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "name",
          "ip"
        ],
        "title": "Device",
        "type": "object"
      },
      "DeviceCreate": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ip": {
            "title": "Ip",
            "type": "string"
          },
          "model": {
            "default": "routeros",
            "title": "Model",
            "type": "string"
          },
          "group": {
            "default": "default",
            "title": "Group",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "ports": {
            "items": {
              "type": "integer"
            },
            "title": "Ports",
            "type": "array"
          },
          "site": {
            "default": "",
            "title": "Site",
            "type": "string"
          },
          "role": {
            "default": "",
            "title": "Role",
            "type": "string"
          },
          "critical": {
            "default": false,
            "title": "Critical",
            "type": "boolean"
          },
          "maintenance": {
            "default": false,
            "title": "Maintenance",
            "type": "boolean"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "name",
          "ip"
        ],
        "title": "DeviceCreate",
        "type": "object"
      },
      "Inventory": {
        "properties": {
          "credential_profiles": {
            "items": {
              "$ref": "#/components/schemas/CredentialProfile"
            },
            "title": "Credential Profiles",
            "type": "array"
          },
          "networks": {
            "items": {
              "$ref": "#/components/schemas/NetworkEntry"
            },
            "title": "Networks",
            "type": "array"
          },
          "devices": {
            "items": {
              "$ref": "#/components/schemas/Device"
            },
            "title": "Devices",
            "type": "array"
          }
        },
        "title": "Inventory",
        "type": "object"
      },
      "CredentialProfile": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "group_name": {
            "title": "Group Name",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "name",
          "group_name",
          "username",
          "password"
        ],
        "title": "CredentialProfile",
        "type": "object"
      },
      "NetworkEntry": {
        "properties": {
          "network": {
            "title": "Network",
            "type": "string"
          },
          "group_name": {
            "default": "default",
            "title": "Group Name",
            "type": "string"
          },
          "environment_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Environment Name"
          },
          "gateway": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Gateway"
          }
        },
        "required": [
          "network"
        ],
        "title": "NetworkEntry",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "auth_source": {
            "default": "local",
            "title": "Auth Source",
            "type": "string"
          },
          "role_locked": {
            "default": false,
            "title": "Role Locked",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "is_active"
        ],
        "title": "UserPublic",
        "type": "object"
      },
      "AuthUserResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "auth_source": {
            "default": "local",
            "title": "Auth Source",
            "type": "string"
          },
          "role_locked": {
            "default": false,
            "title": "Role Locked",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "username",
          "role",
          "permissions"
        ],
        "title": "AuthUserResponse",
        "type": "object"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "title": "Username",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          },
          "role": {
            "default": "viewer",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserUpdate": {
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role"
          },
          "is_active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Active"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Password"
          },
          "role_locked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role Locked"
          },
          "scope_locked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scope Locked"
          },
          "allowed_groups": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Allowed Groups"
          },
          "allowed_sites": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Allowed Sites"
          },
          "custom_role_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Custom Role Id"
          },
          "clear_custom_role": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Clear Custom Role"
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "RbacMatrixResponse": {
        "properties": {
          "roles": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Roles",
            "type": "array"
          },
          "permissions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Permissions",
            "type": "array"
          }
        },
        "required": [
          "roles",
          "permissions"
        ],
        "title": "RbacMatrixResponse",
        "type": "object"
      },
      "LdapConfigPublic": {
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "directory_type": {
            "default": "ldap",
            "title": "Directory Type",
            "type": "string"
          },
          "server": {
            "default": "",
            "title": "Server",
            "type": "string"
          },
          "use_ssl": {
            "default": false,
            "title": "Use Ssl",
            "type": "boolean"
          },
          "start_tls": {
            "default": true,
            "title": "Start Tls",
            "type": "boolean"
          },
          "bind_dn": {
            "default": "",
            "title": "Bind Dn",
            "type": "string"
          },
          "bind_password_set": {
            "default": false,
            "title": "Bind Password Set",
            "type": "boolean"
          },
          "user_base": {
            "default": "",
            "title": "User Base",
            "type": "string"
          },
          "user_filter": {
            "default": "(uid={username})",
            "title": "User Filter",
            "type": "string"
          },
          "user_dn_template": {
            "default": "",
            "title": "User Dn Template",
            "type": "string"
          },
          "user_upn_suffix": {
            "default": "",
            "title": "User Upn Suffix",
            "type": "string"
          },
          "admin_groups": {
            "default": "",
            "title": "Admin Groups",
            "type": "string"
          },
          "operator_groups": {
            "default": "",
            "title": "Operator Groups",
            "type": "string"
          },
          "default_role": {
            "default": "viewer",
            "title": "Default Role",
            "type": "string"
          },
          "fallback_local": {
            "default": true,
            "title": "Fallback Local",
            "type": "boolean"
          },
          "connect_timeout": {
            "default": 10,
            "title": "Connect Timeout",
            "type": "integer"
          },
          "configured": {
            "default": false,
            "title": "Configured",
            "type": "boolean"
          },
          "scope_mappings": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Scope Mappings",
            "type": "array"
          }
        },
        "title": "LdapConfigPublic",
        "type": "object"
      },
      "CustomRole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_system": {
            "type": "boolean"
          }
        }
      },
      "CustomRoleCreate": {
        "type": "object",
        "required": [
          "slug",
          "label",
          "permissions"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Liveness",
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Readiness (DB + Oxidized)",
        "security": []
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Prometheus metrics",
        "security": []
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "This specification",
        "security": []
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login (JWT cookie + body)",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current user profile",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/rbac": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "RBAC matrix (builtin + custom roles)"
      }
    },
    "/api/auth/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List users"
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create local user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        }
      }
    },
    "/api/auth/users/{id}": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Update user (role, scope, custom_role)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete user"
      }
    },
    "/api/auth/api-keys": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List API keys"
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create API key (raw key returned once)"
      }
    },
    "/api/auth/api-keys/{id}": {
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete API key"
      }
    },
    "/api/auth/api-keys/{id}/revoke": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Revoke API key"
      }
    },
    "/api/auth/api-keys/{id}/rotate": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Rotate API key (new secret returned once)"
      }
    },
    "/api/auth/custom-roles": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List custom RBAC roles"
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Create custom role",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomRoleCreate"
              }
            }
          }
        }
      }
    },
    "/api/auth/custom-roles/{id}": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Update custom role"
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete custom role"
      }
    },
    "/api/inventory/import/netbox": {
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Import devices from NetBox"
      }
    },
    "/api/inventory/import/librenms": {
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Import devices from LibreNMS"
      }
    },
    "/api/inventory/topology/netbox": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "Network topology graph from NetBox cables"
      }
    },
    "/api/sites": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "Site hierarchy"
      }
    },
    "/inventory": {
      "get": {
        "tags": [
          "inventory"
        ],
        "summary": "Full inventory",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "inventory"
        ],
        "summary": "Replace inventory"
      }
    },
    "/inventory/devices": {
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Add device",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceCreate"
              }
            }
          }
        }
      }
    },
    "/inventory/devices/bulk": {
      "post": {
        "tags": [
          "inventory"
        ],
        "summary": "Bulk update devices"
      }
    },
    "/scan": {
      "post": {
        "tags": [
          "scan"
        ],
        "summary": "Start scan/discovery"
      }
    },
    "/scan/status": {
      "get": {
        "tags": [
          "scan"
        ],
        "summary": "Scan job status"
      }
    },
    "/scan/latest": {
      "get": {
        "tags": [
          "scan"
        ],
        "summary": "Latest scan results"
      }
    },
    "/api/scan/trends": {
      "get": {
        "tags": [
          "scan"
        ],
        "summary": "Scan trends"
