    "/api/settings/scan": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Scan settings"
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update scan settings"
      }
    },
    "/api/settings/backup": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Backup/notify settings"
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update backup settings"
      }
    },
    "/api/settings/ldap": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "LDAP settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LdapConfigPublic"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update LDAP settings"
