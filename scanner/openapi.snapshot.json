      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update integration settings"
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Audit log"
      }
    },
    "/api/audit/export": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Audit CSV export"
