# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=backup
POSTGRES_PASSWORD=backup
POSTGRES_DB=inventory

# ── Oxidized HTTP source (инвентарь сканера) ────────────
OXIDIZED_SOURCE_URL=http://scanner:8000/api/oxidized/source
# Опционально: токен для /api/oxidized/source (LibreNMS: LIBRENMS_API_TOKEN)
OXIDIZED_SOURCE_TOKEN=

# ── Scanner ─────────────────────────────────────────────
SCANNER_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg2://backup:backup@db:5432/inventory

# ── Auth / RBAC ─────────────────────────────────────────
JWT_SECRET=change-me-to-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_COOKIE_NAME=backup_tools_token

# ── LDAP (опционально) ──────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.example.com:389
LDAP_USE_SSL=false
LDAP_START_TLS=true
# Поиск пользователя (service account)
LDAP_BIND_DN=cn=ldap-reader,ou=service,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=dc=example,dc=com
# Active Directory: (sAMAccountName={username})
LDAP_USER_FILTER=(uid={username})
# Альтернатива поиску: шаблон DN или UPN
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
LDAP_USER_UPN_SUFFIX=@example.com
# Роли по группам LDAP (memberOf / CN)
LDAP_ADMIN_GROUPS=cn=backup-admins,ou=groups,dc=example,dc=com
LDAP_OPERATOR_GROUPS=cn=backup-operators,ou=groups,dc=example,dc=com
LDAP_DEFAULT_ROLE=viewer
LDAP_FALLBACK_LOCAL=true
LDAP_CONNECT_TIMEOUT=10
INVENTORY_PATH=/data/inventory/inventory.yaml
NETWORK_INVENTORY_PATH=/data/inventory/network_inventory.yml
ROUTER_DB_PATH=/data/oxidized/router.db
OXIDIZED_CONFIG_PATH=/data/oxidized/config
OXIDIZED_URL=http://oxidized:8888
OXIDIZED_PUBLIC_URL=http://localhost:8888

# ── Credentials (hex → OVN, us → US) ────────────────────
OVN_USER=satcoadm
OVN_PASS=
US_USER=satcoadm
US_PASS=

# ── Oxidized ────────────────────────────────────────────
OXIDIZED_PORT=8888
ROUTEROS_SSH_PORT=44333
CONFIG_RELOAD_INTERVAL=3600

# ── Git push (бэкапы Oxidized → Gitea/Git) ───────────────
# Рекомендуется HTTP + token (Gitea → Settings → Applications → token, scope write:repository)
GIT_REMOTE_URL=http://10.216.40.65:3000/Oxidized/sat_backup.git
GITEA_TOKEN=
GITEA_HTTP_USER=oauth2
# Альтернатива: SSH только если Gitea SSH настроен (встроенный порт или AuthorizedKeysCommand)
# GIT_REMOTE_URL=git@HOST:Owner/repo.git
GIT_COMMIT_USER=Oxidized
GIT_COMMIT_EMAIL=oxidized@localhost
GIT_BRANCH=main
OXIDIZED_SSH_PASSPHRASE=

# ── Container names ─────────────────────────────────────
DB_CONTAINER_NAME=backup-db
SCANNER_CONTAINER_NAME=oxidized-scanner
OXIDIZED_CONTAINER_NAME=oxidized
