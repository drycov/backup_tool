# Backup Tools — переменные окружения для docker compose / Portainer
# Скопируйте: cp .env.example .env
# Все сервисы (db, scanner, oxidized) читают этот файл через env_file в docker-compose.yml

# ── Пути на хосте (Portainer / Linux) ───────────────────
# Корень репозитория для bind-mount; для Git-deploy Portainer обычно "."
STACK_PATH=.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=backup
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=inventory
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Scanner ─────────────────────────────────────────────
SCANNER_PORT=8000
SCANNER_IMAGE_TAG=latest
LOG_LEVEL=INFO
DEBUG=false
ALLOWED_HOSTS=*

DATABASE_URL=postgresql+psycopg2://backup:change-me-db-password@db:5432/inventory

INVENTORY_PATH=/data/inventory/inventory.yaml
NETWORK_INVENTORY_PATH=/data/inventory/network_inventory.yml
ROUTER_DB_PATH=/data/oxidized/router.db
OXIDIZED_HOME=/data/oxidized
OXIDIZED_CONFIG_PATH=/data/oxidized/config
OXIDIZED_LOG_PATH=/var/lib/oxidized/oxidized.log
OXIDIZED_PYTHON_LOG_PATH=/var/lib/oxidized/oxidized-python.log

# Параллельных ping/port-проверок при scan (защита от Errno 24 Too many open files)
SCAN_CONCURRENCY=50
# Максимум хостов в одной подсети при discovery (ping sweep)
DISCOVER_MAX_HOSTS=4096
DISCOVER_PING_WORKERS=100

# ── Auth / RBAC ─────────────────────────────────────────
JWT_SECRET=change-me-to-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
AUTH_COOKIE_NAME=backup_tools_token

# ── LDAP (опционально; можно настроить в UI → Настройки) ─
LDAP_ENABLED=false
LDAP_AD=false
LDAP_SERVER=ldap://ldap.example.com:389
LDAP_USE_SSL=false
LDAP_START_TLS=true
LDAP_BIND_DN=cn=ldap-reader,ou=service,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=dc=example,dc=com
LDAP_USER_FILTER=(uid={username})
LDAP_USER_DN_TEMPLATE=
LDAP_USER_UPN_SUFFIX=@example.com
LDAP_ADMIN_GROUPS=cn=backup-admins,ou=groups,dc=example,dc=com
LDAP_OPERATOR_GROUPS=cn=backup-operators,ou=groups,dc=example,dc=com
LDAP_DEFAULT_ROLE=viewer
LDAP_FALLBACK_LOCAL=true
LDAP_CONNECT_TIMEOUT=10

# ── Credentials устройств (hex → OVN, us → US) ─────────
OVN_USER=satcoadm
OVN_PASS=
US_USER=satcoadm
US_PASS=
ROUTEROS_SSH_PORT=44333

# ── Oxidized / бэкап конфигов ───────────────────────────
# Движки (подробно: docs/engines.md):
#   python   — встроенный worker в scanner (по умолчанию), контейнер oxidized не нужен
#   external — Ruby Oxidized; docker compose --profile external up -d
OXIDIZED_ENGINE=python
OXIDIZED_INTERVAL=3600
OXIDIZED_THREADS=10
OXIDIZED_TIMEOUT=20
OXIDIZED_RETRIES=3
OXIDIZED_GIT_REPO=/var/lib/oxidized
OXIDIZED_RESOLVE_DNS=true
OXIDIZED_DEFAULT_MODEL=routeros

OXIDIZED_SOURCE_URL=http://scanner:8000/api/oxidized/source
OXIDIZED_SOURCE_TOKEN=

# Только для OXIDIZED_ENGINE=external (Ruby-контейнер)
OXIDIZED_URL=http://oxidized:8888
OXIDIZED_PORT=8888
CONFIG_RELOAD_INTERVAL=3600
OXIDIZED_SSH_PASSPHRASE=

# Публичный URL для кнопок «Oxidized Web ↗» (external) или справки в UI
# Пример: http://10.216.40.65:8888
OXIDIZED_PUBLIC_URL=http://10.216.40.65:8888

# ── Git push (бэкапы → Gitea/Git) ───────────────────────
GIT_REMOTE_URL=http://10.216.40.65:3000/Oxidized/sat_backup.git
GITEA_TOKEN=
GITEA_HTTP_USER=oauth2
GIT_COMMIT_USER=Oxidized
GIT_COMMIT_EMAIL=oxidized@example.com
GIT_BRANCH=main
GIT_SSH_PRIVATE_KEY=/home/oxidized/.ssh/id_rsa
GIT_SSH_PUBLIC_KEY=/home/oxidized/.ssh/id_rsa.pub

# ── MikroTik binary/export backups (RealMikrotikBackup) ─
MK_BACKUP_BINARY=true
MK_BACKUP_EXPORT=true
MK_BACKUP_HIDE_SENSITIVE=false
# MK_BACKUP_ENCRYPT_PASSWORD=
MK_BACKUP_BIN_DIR=/var/lib/oxidized/bin
MK_BACKUP_RSC_DIR=/var/lib/oxidized/rsc
MK_BACKUP_TIMEOUT=300
PURGE_OLD_BACKUP=true
PURGE_N_PIECE=10

# Уведомления (можно настроить в UI → Настройки → Уведомления)
ERROR_NOTIFICATION_TELEGRAM=false
ERROR_NOTIFICATION_EMAIL=false
DEGRADE_NOTIFICATION_TELEGRAM=false
DEGRADE_NOTIFICATION_EMAIL=false
STALE_DAYS_THRESHOLD=30
ALERT_COOLDOWN_HOURS=24
DEGRADE_CHECK_INTERVAL_SEC=3600
REPORT_SEND_TELEGRAM=false
REPORT_SEND_EMAIL=false
TELEGRAM_ACCESS_TOKEN=
TELEGRAM_CHATID_NOTIFY=
TELEGRAM_CHATID_REPORT=
SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=true
SMTP_FROM_MAIL=
SMTP_TO_MAIL_NOTIFY=
SMTP_TO_MAIL_REPORT=
