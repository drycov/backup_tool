# Backup Tools — переменные окружения для docker compose / Portainer
# Скопируйте: cp .env.example .env

# ── Пути на хосте (Portainer / Linux) ───────────────────
# Корень репозитория для bind-mount; для Git-deploy Portainer обычно "."
STACK_PATH=.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=backup
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=inventory
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Scanner ─────────────────────────────────────────────
SCANNER_PORT=8000
SCANNER_IMAGE_TAG=latest
LOG_LEVEL=INFO
DEBUG=false
ALLOWED_HOSTS=*

DATABASE_URL=postgresql+psycopg2://backup:change-me-db-password@db:5432/inventory

INVENTORY_PATH=/data/inventory/inventory.yaml
NETWORK_INVENTORY_PATH=/data/inventory/network_inventory.yml
ROUTER_DB_PATH=/data/oxidized/router.db
OXIDIZED_CONFIG_PATH=/data/oxidized/config
OXIDIZED_LOG_PATH=/var/lib/oxidized/oxidized.log

# ── Auth / RBAC ─────────────────────────────────────────
JWT_SECRET=change-me-to-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
AUTH_COOKIE_NAME=backup_tools_token

# ── LDAP (опционально; можно настроить в UI → Настройки) ─
LDAP_ENABLED=false
LDAP_AD=false
LDAP_SERVER=ldap://ldap.example.com:389
LDAP_USE_SSL=false
LDAP_START_TLS=true
LDAP_BIND_DN=cn=ldap-reader,ou=service,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=dc=example,dc=com
LDAP_USER_FILTER=(uid={username})
LDAP_USER_DN_TEMPLATE=
LDAP_USER_UPN_SUFFIX=@example.com
LDAP_ADMIN_GROUPS=cn=backup-admins,ou=groups,dc=example,dc=com
LDAP_OPERATOR_GROUPS=cn=backup-operators,ou=groups,dc=example,dc=com
LDAP_DEFAULT_ROLE=viewer
LDAP_FALLBACK_LOCAL=true
LDAP_CONNECT_TIMEOUT=10

# ── Oxidized ────────────────────────────────────────────
# python — встроенный движок в scanner (по умолчанию, контейнер oxidized не нужен)
# external — Ruby oxidized; запуск: docker compose --profile external up -d
OXIDIZED_ENGINE=python
OXIDIZED_INTERVAL=3600
OXIDIZED_THREADS=10
OXIDIZED_TIMEOUT=20
OXIDIZED_RETRIES=3
OXIDIZED_GIT_REPO=/var/lib/oxidized

OXIDIZED_SOURCE_URL=http://scanner:8000/api/oxidized/source
OXIDIZED_SOURCE_TOKEN=

# Для OXIDIZED_ENGINE=external — URL Ruby-контейнера
OXIDIZED_URL=http://oxidized:8888

# Публичный URL для кнопок «Oxidized Web ↗» в браузере пользователя.
# Docker на том же сервере: IP или DNS хоста + проброшенный порт (OXIDIZED_PORT).
# Пример: http://10.216.40.65:8888
# НЕ используйте: localhost (если UI открывают с других ПК), oxidized, scanner.
# Oxidized UI (iframe) и diff работают через Scanner: http://<IP>:8000/oxidized-proxy/...
OXIDIZED_PUBLIC_URL=http://10.216.40.65:8888

# ── Credentials (hex → OVN, us → US) ────────────────────
OVN_USER=satcoadm
OVN_PASS=
US_USER=satcoadm
US_PASS=

# ── Oxidized ────────────────────────────────────────────
OXIDIZED_PORT=8888
ROUTEROS_SSH_PORT=44333
# Параллельных ping/port-проверок при scan (защита от Errno 24 Too many open files)
SCAN_CONCURRENCY=50
CONFIG_RELOAD_INTERVAL=3600
OXIDIZED_SSH_PASSPHRASE=

# ── Git push (бэкапы Oxidized → Gitea/Git) ───────────────
# HTTP + token (порт 22 — системный sshd без Gitea; deploy keys не работают)
GIT_REMOTE_URL=http://10.216.40.65:3000/Oxidized/sat_backup.git
GITEA_TOKEN=
GITEA_HTTP_USER=oauth2
GIT_COMMIT_USER=Oxidized
GIT_COMMIT_EMAIL=oxidized@example.com
GIT_BRANCH=main
